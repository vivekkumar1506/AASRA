          }
        ],
        "lineageTag": "6048adcd-74f2-4a0c-a869-a97dcd0d187a",
        "measures": [
          {
            "name": "IVF Patients",
            "expression": "SUM ( Fact_IVF[IVF_Patients] )",
            "formatString": "#,##0",
            "lineageTag": "1201cfcb-e676-415c-80fc-b223b8e2d871"
          },
          {
            "name": "ART Cycles",
            "expression": "SUM ( Fact_IVF[ART_Cycles] )",
            "formatString": "#,##0",
            "lineageTag": "3d4333d5-7c26-4290-b863-eab8e4af2ce8"
          },
          {
            "name": "Successful Cycles",
            "expression": "SUM ( Fact_IVF[Successful_Cycles] )",
            "formatString": "#,##0",
            "lineageTag": "27e01f73-7de0-4e20-b45a-098de2984e97"
          },
          {
            "name": "IVF Success Rate",
            "expression": "DIVIDE ( [Successful Cycles], [ART Cycles] )",
            "formatString": "0.0%",
            "lineageTag": "8d739943-a36c-4bc2-9cff-21de93c35271"
          },
          {
            "name": "Avg IVF Cost",
            "expression": "AVERAGE ( Fact_IVF[Avg_Cost_INR] )",
            "formatString": "#,##0",
            "lineageTag": "8744e60f-7e77-4b29-a9ff-69232bef5fac"
          },
          {
            "name": "Total Adoptions",
            "expression": "SUM ( Fact_Adoption_State[Total_Adoptions] )",
            "formatString": "#,##0",
            "lineageTag": "41f467c1-7d3e-4aeb-a630-fb6f53d0a81e"
          },
          {
            "name": "Female Adoptions",
            "expression": "SUM ( Fact_Adoption_State[Female_Adoptions] )",
            "formatString": "#,##0",
            "lineageTag": "8b6dbe58-e689-4906-9754-7c1010fd085e"
          },
          {
            "name": "Male Adoptions",
            "expression": "SUM ( Fact_Adoption_State[Male_Adoptions] )",
            "formatString": "#,##0",
            "lineageTag": "fc3321ef-51e6-488d-a487-8e56c58a9fa8"
          },
          {
            "name": "Female Share",
            "expression": "DIVIDE ( [Female Adoptions], [Total Adoptions] )",
            "formatString": "0.0%",
            "lineageTag": "b4fc347a-277f-44a5-9630-2e81875de14b"
          },
          {
            "name": "Children in Care",
            "expression": "COUNTROWS ( Fact_Children_In_Care )",
            "formatString": "#,##0",
            "lineageTag": "e4bc2164-d11a-4891-b090-18c1d5978017"
          },
          {
            "name": "Legally Free",
            "expression": "CALCULATE ( [Children in Care], Fact_Children_In_Care[Legal_Status] = \"Legally_Free_for_Adoption\" )",
            "formatString": "#,##0",
            "lineageTag": "255c6788-a1d6-46b1-b579-38e8f41ee456"
          },
          {
            "name": "Matched",
            "expression": "CALCULATE ( [Children in Care], Fact_Children_In_Care[Case_Status] = \"Matched\" )",
            "formatString": "#,##0",
            "lineageTag": "dcb80256-2a85-42b9-8b31-7bc92c940c5c"
          },
          {
            "name": "Special Needs",
            "expression": "CALCULATE ( [Children in Care], Fact_Children_In_Care[Special_Needs] = \"Yes\" )",
            "formatString": "#,##0",
            "lineageTag": "75df23dc-4e65-4334-a3ea-5c062ac90122"
          },
          {
            "name": "Special Needs %",
            "expression": "DIVIDE ( [Special Needs], [Children in Care] )",
            "formatString": "0.0%",
            "lineageTag": "66069583-b666-4714-ad90-3f9b6795f907"
          },
          {
            "name": "IVF Patients per Adoption",
            "expression": "DIVIDE ( [IVF Patients], [Total Adoptions] )",
            "formatString": "0.0",
            "lineageTag": "16c77d8e-dc1a-4b06-9b4a-62710c564caa"
          },
          {
            "name": "Legally Free per 100 IVF Patients",
            "expression": "DIVIDE ( [Legally Free], [IVF Patients] ) * 100",
            "formatString": "0.0",
            "lineageTag": "9889d5ef-b446-4ab3-8aa5-8a3eb3a14780"
          },
          {
            "name": "Trend Adoptions",
            "expression": "SUM ( Fact_Adoption_Trend[Total_Adoptions] )",
            "formatString": "#,##0",
            "lineageTag": "bac29b63-660b-4265-ae44-097519302fbe"
          },
          {
            "name": "Infertility Prevalence %",
            "expression": "CALCULATE ( MAX ( KPI_Reference[Value] ), KPI_Reference[KPI] = \"Infertility prevalence India (%)\" ) / 100",
            "formatString": "0.0%",
            "lineageTag": "a4b7999b-4e81-46be-b0e0-0dd38bf35cf6"
          }
        ],
        "partitions": [
          {
            "name": "Key Measures",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = #table(type table [Dummy = Int64.Type], {{1}})",
                "in",
                "    Source"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
